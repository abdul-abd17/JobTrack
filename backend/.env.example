# ==============================================================================
# JobTrack Backend Environment Configuration (.env.example)
# Duplicate this file as .env and populate with appropriate values.
# NEVER commit the actual .env file with secrets to Git.
# ==============================================================================

# Core Django Settings
# In production (DEBUG=False), SECRET_KEY must be a cryptographically random 50+ character string.
SECRET_KEY=generate-a-strong-random-secret-key-at-least-50-characters-long
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Render Environment Variable (automatically populated by Render runtime)
# RENDER_EXTERNAL_HOSTNAME=jobtrack-api.onrender.com

# CORS & CSRF Settings (Vercel Frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Settings (Managed MySQL)
# For local dev without a running MySQL server, set USE_SQLITE_FALLBACK=True.
# NOTE: USE_SQLITE_FALLBACK=True is strictly prohibited when DEBUG=False.
USE_SQLITE_FALLBACK=True

DB_NAME=jobtrack_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Managed MySQL SSL/TLS Settings
# Set DB_SSL_REQUIRED=True if your cloud MySQL provider requires encrypted TLS.
# Optional: Set DB_SSL_CA to the path of your custom CA cert bundle (e.g., /etc/ssl/certs/ca-certificates.crt).
DB_SSL_REQUIRED=False
DB_SSL_CA=
DB_SSL_CHECK_HOSTNAME=True

# Production Security & SSL Redirects (effective when DEBUG=False)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
