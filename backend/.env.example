# Django Settings
SECRET_KEY=your-super-secret-key-replace-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Settings (Frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Settings (MySQL via PyMySQL)
DB_ENGINE=django.db.backends.mysql
DB_NAME=jobtrack_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Set to True for development fallback if local MySQL server is not active
USE_SQLITE_FALLBACK=True

